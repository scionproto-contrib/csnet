# ngtcp2 as a plain list of sources, compiled into the scion_quic library by the Linux build and by the ESP-IDF
# component alike (ngtcp2's own build looks for the TLS libraries with pkg-config, which does not work for ESP-IDF).
#
#   scion_ngtcp2_sources(<ngtcp2 source dir> <crypto backend: picotls|quictls> <dir for generated headers>)
#
# Sets NGTCP2_SOURCES, NGTCP2_INCLUDE_DIRS and NGTCP2_DEFINITIONS in the calling scope.
function(scion_ngtcp2_sources NGTCP2_DIR BACKEND GEN_DIR)
    file(GLOB lib_sources ${NGTCP2_DIR}/lib/*.c)
    set(NGTCP2_SOURCES ${lib_sources} ${NGTCP2_DIR}/crypto/shared.c ${NGTCP2_DIR}/crypto/${BACKEND}/${BACKEND}.c
            PARENT_SCOPE)

    # version.h is generated by ngtcp2's build
    file(MAKE_DIRECTORY ${GEN_DIR}/ngtcp2)
    file(READ ${NGTCP2_DIR}/CMakeLists.txt ngtcp2_cmake)
    string(REGEX MATCH "project\\(ngtcp2 VERSION ([0-9]+)\\.([0-9]+)\\.([0-9]+)" _ "${ngtcp2_cmake}")
    set(PACKAGE_VERSION ${CMAKE_MATCH_1}.${CMAKE_MATCH_2}.${CMAKE_MATCH_3})
    math(EXPR PACKAGE_VERSION_NUM "(${CMAKE_MATCH_1} << 16) + (${CMAKE_MATCH_2} << 8) + ${CMAKE_MATCH_3}"
            OUTPUT_FORMAT HEXADECIMAL)
    configure_file(${NGTCP2_DIR}/lib/includes/ngtcp2/version.h.in ${GEN_DIR}/ngtcp2/version.h @ONLY)

    # config.h: the features of Linux (glibc) and ESP-IDF (newlib/picolibc with lwIP) that ngtcp2 asks for
    file(WRITE ${GEN_DIR}/config.h
            "#define HAVE_ARPA_INET_H 1\n#define HAVE_NETINET_IN_H 1\n#define HAVE_UNISTD_H 1\n"
            "#define HAVE_STRING_H 1\n#define HAVE_STDINT_H 1\n#define HAVE_ENDIAN_H 1\n"
            "#define HAVE_DECL_BE64TOH 1\n#define HAVE_EXPLICIT_BZERO 1\n")

    set(NGTCP2_INCLUDE_DIRS ${NGTCP2_DIR}/lib/includes ${NGTCP2_DIR}/lib ${NGTCP2_DIR}/crypto
            ${NGTCP2_DIR}/crypto/includes ${GEN_DIR} PARENT_SCOPE)
    set(NGTCP2_DEFINITIONS HAVE_CONFIG_H NGTCP2_STATICLIB NGTCP2_CRYPTO_STATICLIB BUILDING_NGTCP2 PARENT_SCOPE)
endfunction()
